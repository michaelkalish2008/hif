#!/bin/sh
# Refuse a commit that leaves the website behind.
#
# The site renders copies of README.md and docs/*.md rather than restating
# them (tools/sync_docs.py), and generates its measurement vocabulary from
# `hif schema` (tools/gen_site_measurements.py). docs/FLAGS.md is generated
# from the command surface itself (tools/gen_flags_doc.py). A copy that is
# only updated when someone remembers is not a copy for long, so the checks
# run here.
#
# Each fires only when the files it guards are actually staged, and both pass
# quietly when the site is not checked out — working on the CLI alone must not
# need the site present.
#
# Install: git config core.hooksPath tools/hooks

staged=$(git diff --cached --name-only --diff-filter=ACM)

case "$staged" in
  *README.md*|*docs/*.md*)
    python3 tools/sync_docs.py --check || {
      echo
      echo "pre-commit: documentation the site publishes has drifted from this repo."
      echo "Run: python3 tools/regen_docs.py   (regenerates and syncs in one pass)"
      echo "Then review the change in the site repo and commit again."
      echo "To commit anyway: git commit --no-verify"
      exit 1
    }
    ;;
esac

# Being generated only means the doc was right when someone last ran the
# generator. Rename a flag and forget, and docs/FLAGS.md describes the old
# surface with no more warning than a hand-written list would have given —
# the failure tools/gen_flags_doc.py exists to prevent. Needs no site
# checkout: this one compares the repo against itself.
case "$staged" in
  *hif/cli/*.py*|*tools/gen_flags_doc.py*|*models/capabilities.py*)
    python3 tools/gen_flags_doc.py --check || {
      echo
      echo "pre-commit: docs/FLAGS.md has drifted from the command surface."
      echo "Run: python3 tools/regen_docs.py   (regenerates and syncs in one pass)"
      echo "Then review the diff and commit again."
      echo "To commit anyway: git commit --no-verify"
      exit 1
    }
    ;;
esac

# The registry is the site's measurement vocabulary. hif-v4 cut the set from
# sixteen rows to six and the site went on rendering all sixteen, pinned at
# hif-v3.1, because its copy was a hand transcription nobody re-read.
case "$staged" in
  *profile/registry.py*|*tools/gen_site_measurements.py*)
    python3 tools/gen_site_measurements.py --check || {
      echo
      echo "pre-commit: the site's measurement vocabulary has drifted from 'hif schema'."
      echo "Run: python3 tools/regen_docs.py   (regenerates and syncs in one pass)"
      echo "Then review the change in the site repo and commit again."
      echo "To commit anyway: git commit --no-verify"
      exit 1
    }

    # The published corpus is the evidence for every number on the site, and
    # it is the surface that drifted furthest: hif-v4 cut ten rows and 120
    # profiles went on carrying seven of them, unstamped. Fetches a ~6KB
    # manifest, not the 390MB corpus, and passes quietly when offline —
    # a hook must not block a commit on the network.
    python3 tools/check_corpus.py --check || {
      echo
      echo "pre-commit: the published corpus describes a different measurement set."
      echo "Recompute the blocks, re-upload, rerun --write, and upload the manifest."
      echo "To commit anyway: git commit --no-verify"
      exit 1
    }
    ;;
esac
